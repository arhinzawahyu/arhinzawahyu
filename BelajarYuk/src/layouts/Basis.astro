---
import "../styles/global.css";

interface Props {
  judul: string;
}

const { judul } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{judul}</title>
  </head>
  <body class="min-h-dvh bg-base text-ink antialiased">
    <slot />
  </body>
</html>
