# Salin file ini menjadi .env lalu isi nilainya.
# Semua nilai ini rahasia dan hanya dipakai di server Astro (jangan pernah ke browser).

# Postgres Supabase: Project Settings > Database > Connection string (pooler)
DATABASE_URL=

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
